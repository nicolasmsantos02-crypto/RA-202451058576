
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }



        :root {
            --amarelo: #f5c400;
            --amarelo-hover: #ffd633;
            --preto: #000000;
            --fundo: #111111;
            --card: #1c1c1c;
            --cinza: #dddddd;
            --cinza-claro: #f5f5f5;
            --cinza-borda: #555555;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background-color: var(--fundo);
            color: var(--cinza-claro);
            line-height: 1.7;
        }

        a {
            color: inherit;
        }


     
        header {
            background-color: var(--preto);
            border-bottom: 4px solid var(--amarelo);
            padding: 25px 40px;
            text-align: center;
            box-shadow: 0 4px 15px rgba(245, 196, 0, 0.25);
        }

        header h1 {
            color: var(--amarelo);
            font-size: 36px;
            margin-bottom: 20px;
            text-transform: uppercase;
            letter-spacing: 2px;
        }


     

        nav ul {
            display: flex;
            justify-content: center;
            gap: 10px;
            list-style: none;
            flex-wrap: wrap;
        }

        nav a {
            display: inline-block;
            color: var(--preto);
            background-color: var(--amarelo);
            text-decoration: none;
            font-weight: bold;
            padding: 10px 18px;
            border-radius: 6px;
            transition: 0.3s ease;
        }

        nav a:hover {
            background-color: white;
            color: var(--preto);
            transform: translateY(-2px);
        }


        
        main {
            max-width: 1100px;
            margin: 40px auto;
            padding: 0 25px;
        }

        section {
            background-color: var(--card);
            border-left: 5px solid var(--amarelo);
            padding: 25px;
            margin-bottom: 40px;
            border-radius: 8px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.4);
        }

        .introducao {
            border: 1px solid var(--amarelo);
        }

        h2,
        h3 {
            color: var(--amarelo);
            margin-bottom: 15px;
        }

        h2 {
            font-size: 28px;
        }

        h3 {
            font-size: 24px;
        }

        p {
            color: var(--cinza);
            font-size: 17px;
            margin-bottom: 20px;
        }

        li {
            margin-bottom: 20px;
            color: var(--cinza);
        }

        strong {
            color: var(--amarelo);
        }


       

        .catalogo {
            border-left: 5px solid var(--amarelo);
        }

        .catalogo-introducao {
            margin-bottom: 30px;
        }

        .produtos {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }


        

        .card {
            background: linear-gradient(
                145deg,
                #242424,
                #151515
            );

            border: 1px solid #3d3d3d;
            border-top: 4px solid var(--amarelo);

            border-radius: 10px;
            padding: 25px;

            min-height: 250px;

            display: flex;
            flex-direction: column;

            box-shadow:
                0 5px 15px rgba(0, 0, 0, 0.45);

            transition:
                transform 0.3s ease,
                box-shadow 0.3s ease,
                border-color 0.3s ease;
        }

        .card:hover {
            transform: translateY(-8px);

            border-color: var(--amarelo);

            box-shadow:
                0 10px 25px rgba(245, 196, 0, 0.20);
        }

        .card h3 {
            color: var(--amarelo);
            font-size: 22px;
            margin-bottom: 12px;
        }

        .card p {
            color: #cccccc;
            font-size: 16px;
            margin-bottom: 20px;
        }

        .card button {
            margin-top: auto;

            background-color: var(--amarelo);
            color: var(--preto);

            border: none;
            border-radius: 6px;

            padding: 11px 18px;

            font-size: 15px;
            font-weight: bold;

            cursor: pointer;

            transition: 0.3s ease;
        }

        .card button:hover {
            background-color: white;
            transform: scale(1.03);
        }


       

        .formulario-cadastro {
            background-color: var(--card);
            border-left: 5px solid var(--amarelo);

            padding: 25px;
            margin-bottom: 40px;

            border-radius: 8px;

            box-shadow:
                0 5px 15px rgba(0, 0, 0, 0.4);
        }

        .formulario-cadastro form {
            display: flex;
            flex-direction: column;
        }

        .formulario-cadastro fieldset {
            border: 1px solid var(--amarelo);
            padding: 25px;
            border-radius: 8px;
        }

        .formulario-cadastro legend {
            color: var(--amarelo);
            font-size: 22px;
            font-weight: bold;
            padding: 0 10px;
        }

        .formulario-cadastro label {
            display: block;
            color: var(--cinza);
            font-weight: bold;
            margin-top: 15px;
        }

        .formulario-cadastro input {
            width: 100%;

            background-color: var(--fundo);
            color: white;

            border: 1px solid var(--cinza-borda);
            border-radius: 5px;

            padding: 12px;
            margin-top: 5px;

            font-size: 16px;
        }

        .formulario-cadastro input:focus {
            outline: none;
            border-color: var(--amarelo);

            box-shadow:
                0 0 5px rgba(245, 196, 0, 0.3);
        }

        .formulario-cadastro button {
            background-color: var(--amarelo);
            color: var(--preto);

            border: none;
            border-radius: 6px;

            padding: 12px 20px;
            margin-top: 20px;

            font-size: 16px;
            font-weight: bold;

            cursor: pointer;

            transition: 0.3s ease;
        }

        .formulario-cadastro button:hover {
            background-color: white;
            transform: translateY(-2px);
        }


       

        footer {
            background-color: var(--preto);
            border-top: 2px solid var(--amarelo);

            padding: 25px;
            text-align: center;

            color: #aaaaaa;
        }

        footer p {
            margin: 0;
            color: #aaaaaa;
            font-size: 14px;
        }


       

        @media (max-width: 850px) {

            .produtos {
                grid-template-columns: repeat(2, 1fr);
            }
        }


        @media (max-width: 600px) {

            header {
                padding: 20px 15px;
            }

            header h1 {
                font-size: 26px;
            }

            nav ul {
                flex-direction: column;
            }

            nav a {
                width: 100%;
            }

            main {
                padding: 0 15px;
            }

            p {
                font-size: 16px;
            }

            .produtos {
                grid-template-columns: 1fr;
            }

            section,
            .formulario-cadastro {
                padding: 20px;
            }

            .card {
                min-height: 220px;
            }
        }







