<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="description"
        content="Cervejaria Salto de Fé — conheça a história da cerveja e nosso catálogo de produtos.">

    <title>Cervejaria Salto de Fé</title>

    <style>
      
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }



        :root {
            --amarelo: #f5c400;
            --amarelo-hover: #ffd633;
            --preto: #000000;
            --fundo: #111111;
            --card: #1c1c1c;
            --cinza: #dddddd;
            --cinza-claro: #f5f5f5;
            --cinza-borda: #555555;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background-color: var(--fundo);
            color: var(--cinza-claro);
            line-height: 1.7;
        }

        a {
            color: inherit;
        }


     
        header {
            background-color: var(--preto);
            border-bottom: 4px solid var(--amarelo);
            padding: 25px 40px;
            text-align: center;
            box-shadow: 0 4px 15px rgba(245, 196, 0, 0.25);
        }

        header h1 {
            color: var(--amarelo);
            font-size: 36px;
            margin-bottom: 20px;
            text-transform: uppercase;
            letter-spacing: 2px;
        }


     

        nav ul {
            display: flex;
            justify-content: center;
            gap: 10px;
            list-style: none;
            flex-wrap: wrap;
        }

        nav a {
            display: inline-block;
            color: var(--preto);
            background-color: var(--amarelo);
            text-decoration: none;
            font-weight: bold;
            padding: 10px 18px;
            border-radius: 6px;
            transition: 0.3s ease;
        }

        nav a:hover {
            background-color: white;
            color: var(--preto);
            transform: translateY(-2px);
        }


        
        main {
            max-width: 1100px;
            margin: 40px auto;
            padding: 0 25px;
        }

        section {
            background-color: var(--card);
            border-left: 5px solid var(--amarelo);
            padding: 25px;
            margin-bottom: 40px;
            border-radius: 8px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.4);
        }

        .introducao {
            border: 1px solid var(--amarelo);
        }

        h2,
        h3 {
            color: var(--amarelo);
            margin-bottom: 15px;
        }

        h2 {
            font-size: 28px;
        }

        h3 {
            font-size: 24px;
        }

        p {
            color: var(--cinza);
            font-size: 17px;
            margin-bottom: 20px;
        }

        li {
            margin-bottom: 20px;
            color: var(--cinza);
        }

        strong {
            color: var(--amarelo);
        }


       

        .catalogo {
            border-left: 5px solid var(--amarelo);
        }

        .catalogo-introducao {
            margin-bottom: 30px;
        }

        .produtos {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }


        

        .card {
            background: linear-gradient(
                145deg,
                #242424,
                #151515
            );

            border: 1px solid #3d3d3d;
            border-top: 4px solid var(--amarelo);

            border-radius: 10px;
            padding: 25px;

            min-height: 250px;

            display: flex;
            flex-direction: column;

            box-shadow:
                0 5px 15px rgba(0, 0, 0, 0.45);

            transition:
                transform 0.3s ease,
                box-shadow 0.3s ease,
                border-color 0.3s ease;
        }

        .card:hover {
            transform: translateY(-8px);

            border-color: var(--amarelo);

            box-shadow:
                0 10px 25px rgba(245, 196, 0, 0.20);
        }

        .card h3 {
            color: var(--amarelo);
            font-size: 22px;
            margin-bottom: 12px;
        }

        .card p {
            color: #cccccc;
            font-size: 16px;
            margin-bottom: 20px;
        }

        .card button {
            margin-top: auto;

            background-color: var(--amarelo);
            color: var(--preto);

            border: none;
            border-radius: 6px;

            padding: 11px 18px;

            font-size: 15px;
            font-weight: bold;

            cursor: pointer;

            transition: 0.3s ease;
        }

        .card button:hover {
            background-color: white;
            transform: scale(1.03);
        }


       

        .formulario-cadastro {
            background-color: var(--card);
            border-left: 5px solid var(--amarelo);

            padding: 25px;
            margin-bottom: 40px;

            border-radius: 8px;

            box-shadow:
                0 5px 15px rgba(0, 0, 0, 0.4);
        }

        .formulario-cadastro form {
            display: flex;
            flex-direction: column;
        }

        .formulario-cadastro fieldset {
            border: 1px solid var(--amarelo);
            padding: 25px;
            border-radius: 8px;
        }

        .formulario-cadastro legend {
            color: var(--amarelo);
            font-size: 22px;
            font-weight: bold;
            padding: 0 10px;
        }

        .formulario-cadastro label {
            display: block;
            color: var(--cinza);
            font-weight: bold;
            margin-top: 15px;
        }

        .formulario-cadastro input {
            width: 100%;

            background-color: var(--fundo);
            color: white;

            border: 1px solid var(--cinza-borda);
            border-radius: 5px;

            padding: 12px;
            margin-top: 5px;

            font-size: 16px;
        }

        .formulario-cadastro input:focus {
            outline: none;
            border-color: var(--amarelo);

            box-shadow:
                0 0 5px rgba(245, 196, 0, 0.3);
        }

        .formulario-cadastro button {
            background-color: var(--amarelo);
            color: var(--preto);

            border: none;
            border-radius: 6px;

            padding: 12px 20px;
            margin-top: 20px;

            font-size: 16px;
            font-weight: bold;

            cursor: pointer;

            transition: 0.3s ease;
        }

        .formulario-cadastro button:hover {
            background-color: white;
            transform: translateY(-2px);
        }


       

        footer {
            background-color: var(--preto);
            border-top: 2px solid var(--amarelo);

            padding: 25px;
            text-align: center;

            color: #aaaaaa;
        }

        footer p {
            margin: 0;
            color: #aaaaaa;
            font-size: 14px;
        }


       

        @media (max-width: 850px) {

            .produtos {
                grid-template-columns: repeat(2, 1fr);
            }
        }


        @media (max-width: 600px) {

            header {
                padding: 20px 15px;
            }

            header h1 {
                font-size: 26px;
            }

            nav ul {
                flex-direction: column;
            }

            nav a {
                width: 100%;
            }

            main {
                padding: 0 15px;
            }

            p {
                font-size: 16px;
            }

            .produtos {
                grid-template-columns: 1fr;
            }

            section,
            .formulario-cadastro {
                padding: 20px;
            }

            .card {
                min-height: 220px;
            }
        }
    </style>
</head>


<body>

    
    <header>
        <h1>Cervejaria Salto de Fé</h1>

        <nav aria-label="Navegação principal">
            <ul>
                <li>
                    <a href="Tipos-de-Cerveja.html">
                        Tipos de Cerveja
                    </a>
                </li>

                <li>
                    <a href="Sobre-nos.html">
                        Sobre Nós
                    </a>
                </li>

                <li>
                    <a href="Contato.html">
                        Contato
                    </a>
                </li>

                <li>
                    <a href="#cadastro">
                        Cadastro
                    </a>
                </li>
            </ul>
        </nav>
    </header>


  
    <main>

        
        <section class="introducao" aria-labelledby="introducao-titulo">

            <h2 id="introducao-titulo">
                Bem-vindo à Salto de Fé
            </h2>

            <p>
                Aqui, tradição, sabor e paixão pela cerveja se encontram.
                Conheça um pouco da fascinante história da cerveja, desde
                suas origens até os dias de hoje, e descubra como essa
                bebida conquistou gerações ao redor do mundo.
            </p>

            <p>
                E para tornar essa experiência ainda mais especial,
                convidamos você a conhecer nosso catálogo de produtos
                e explorar as opções que preparamos para você.
            </p>

            <p>
                Salto de Fé — uma história para conhecer,
                uma cerveja para apreciar.
            </p>

        </section>


       
        <section aria-labelledby="origem-titulo">

            <h2 id="origem-titulo">
                Origem da cerveja
            </h2>

            <p>
                Historiadores mencionam o surgimento acidental da cerveja
                em diferentes partes do mundo. A bebida surgiu quando grãos
                de cevada ou trigo armazenados fermentaram de forma natural,
                com leveduras do ambiente após entrarem em contato com a água.
            </p>

        </section>


       
        <section aria-labelledby="diferencas-titulo">

            <h2 id="diferencas-titulo">
                O que diferencia um tipo de cerveja de outro?
            </h2>

            <p>
                As cervejas diferem principalmente devido ao tipo de levedura,
                à temperatura de fermentação e aos ingredientes da receita.
                Embora levem água, malte, lúpulo e levedura em sua base,
                esses fatores criam grandes famílias e estilos únicos.
            </p>

            <h3>
                Principais famílias de cerveja
            </h3>

            <ul>

                <li>
                    <strong>Lager:</strong>
                    fermentam em temperaturas mais baixas, geralmente entre
                    5 °C e 14 °C, utilizando leveduras que atuam principalmente
                    na parte inferior do tanque.
                </li>

                <li>
                    <strong>Ale:</strong>
                    fermentam em temperaturas mais altas, geralmente entre
                    15 °C e 24 °C, utilizando leveduras que atuam principalmente
                    na parte superior.
                </li>

                <li>
                    <strong>Lambic:</strong>
                    utilizam fermentação espontânea, permitindo que
                    microrganismos presentes no ambiente participem do
                    processo de fermentação.
                </li>

            </ul>

        </section>


        
        <section class="catalogo" aria-labelledby="catalogo-titulo">

            <header class="catalogo-introducao">
                <h2 id="catalogo-titulo">
                    Nosso catálogo
                </h2>

                <p>
                    Conheça algumas das cervejas e bebidas
                    disponíveis na Cervejaria Salto de Fé.
                </p>
            </header>


            <div class="produtos">

                <article class="card">
                    <h3>Buraco Negro</h3>

                    <p>
                        Oatmeal Stout com cacau —
                        6% Vol. Alc.
                    </p>

                    <button type="button">
                        Ver item
                    </button>
                </article>


                <article class="card">
                    <h3>IPA Rola Moça</h3>

                    <p>
                        American IPA —
                        6,1% Vol. Alc.
                    </p>

                    <button type="button">
                        Ver item
                    </button>
                </article>


                <article class="card">
                    <h3>D'Alma</h3>

                    <p>
                        Dark Strong Ale —
                        10,1% Vol. Alc. —
                        IBU 27.
                    </p>

                    <button type="button">
                        Ver item
                    </button>
                </article>


                <article class="card">
                    <h3>Ruptura</h3>

                    <p>
                        American IPA —
                        6,04% Vol. Alc.
                    </p>

                    <button type="button">
                        Ver item
                    </button>
                </article>


                <article class="card">
                    <h3>Canvas</h3>

                    <p>
                        Hop Lager —
                        4,5% Vol. Alc.
                    </p>

                    <button type="button">
                        Ver item
                    </button>
                </article>


                <article class="card">
                    <h3>D'Inteiro</h3>

                    <p>
                        American Lager —
                        4,7% Vol. Alc.
                    </p>

                    <button type="button">
                        Ver item
                    </button>
                </article>


                <article class="card">
                    <h3>Aurora Rubra</h3>

                    <p>
                        Munich Dunkel.
                    </p>

                    <button type="button">
                        Ver item
                    </button>
                </article>


                <article class="card">
                    <h3>Salto Fino</h3>

                    <p>
                        Bebida mista de gin
                        e Pink Lemonade.
                    </p>

                    <button type="button">
                        Ver item
                    </button>
                </article>

            </div>

        </section>


        
        <section
            class="formulario-cadastro"
            id="cadastro"
            aria-labelledby="cadastro-titulo"
        >

            <h2 id="cadastro-titulo">
                Cadastro
            </h2>

            <form action="/enviar" method="post">

                <fieldset>

                    <legend>
                        Seus dados
                    </legend>


                    <label for="nome">
                        Nome completo
                    </label>

                    <input
                        type="text"
                        id="nome"
                        name="nome"
                        required
                        minlength="3"
                        autocomplete="name"
                    >


                    <label for="email">
                        E-mail
                    </label>

                    <input
                        type="email"
                        id="email"
                        name="email"
                        required
                        autocomplete="email"
                    >


                    <label for="telefone">
                        Telefone
                    </label>

                    <input
                        type="tel"
                        id="telefone"
                        name="telefone"
                        required
                        autocomplete="tel"
                    >


                    <label for="cpf">
                        CPF
                    </label>

                    <input
                        type="text"
                        id="cpf"
                        name="cpf"
                        required
                        inputmode="numeric"
                    >


                    <label for="idade">
                        Idade
                    </label>

                    <input
                        type="number"
                        id="idade"
                        name="idade"
                        required
                        min="18"
                        max="120"
                    >


                    <button type="submit">
                        Enviar cadastro
                    </button>

                </fieldset>

            </form>

        </section>

    </main>


    <footer>

        <p>
            &copy; 2026 Cervejaria Salto de Fé.
            Todos os direitos reservados.
        </p>

    </footer>

</body>

</html>
