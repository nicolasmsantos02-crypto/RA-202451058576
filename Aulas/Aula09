 6      console.log(filme.titulo, curtidas);
 7    }
 8  
 9    return (
10      <article className="cartao">
11        <h2>{filme.titulo}</h2>
12        <p>{filme.ano} · {filme.genero} · {filme.duracao} min</p>
13        <button onClick={curtir}>Curtir ({curtidas})</button>
14      </article>
15    );
